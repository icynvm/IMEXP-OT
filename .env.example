# =====================================================================
# คัดลอกไฟล์นี้เป็น .env.local (สำหรับรันในเครื่อง)
# และใส่ค่าเดียวกันใน Vercel > Project > Settings > Environment Variables
# =====================================================================

# --- Supabase (Dashboard > Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (ขึ้นต้น sb_publishable_...) หรือ anon key แบบเดิม
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Secret key (ขึ้นต้น sb_secret_...) หรือ service_role key แบบเดิม
# !!! ห้ามเปิดเผย ห้ามใส่ NEXT_PUBLIC_ นำหน้า ใช้เฉพาะฝั่ง server (ส่งอีเมล / เช็กรหัสพนักงานซ้ำ)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Resend (resend.com > API Keys) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# อีเมลผู้ส่ง ต้องเป็นโดเมนที่ verify ใน Resend แล้ว (ทดสอบใช้ onboarding@resend.dev ได้)
EMAIL_FROM="ระบบ OT <ot@your-company.com>"

# --- URL ของเว็บ (ใช้ทำลิงก์ในอีเมล) ---
# ในเครื่อง: http://localhost:3000   บน Vercel: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
